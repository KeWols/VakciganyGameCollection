{
  "name": "midnight-withdrawal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write apps packages vite.config.ts tsconfig.json package.json",
    "test": "vitest run",
    "test:smoke": "tsx apps/server/src/smoke.ts",
    "test:rabbit": "tsx apps/server/src/smoke.ts --rabbit",
    "start": "tsx apps/server/src/index.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.8",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
